# Normalize every text file to LF in the repository and the working tree.
# Windows checkouts must not re-introduce CRLF; refuse "auto" drift.
* text=auto eol=lf

# Binary artefacts: never convert, never diff.
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.ogg binary
*.wav binary
*.webm binary
*.mp4 binary
*.zip binary
*.gz binary
*.bin binary
